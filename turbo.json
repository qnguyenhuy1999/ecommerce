{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "prisma/**",
        "public/**",
        "components.json",
        "tsconfig.json",
        "tsconfig*.json",
        "package.json",
        "tsup.config.ts",
        "vite.config.*",
        "tailwind.config.*",
        "next.config.*",
        "nest-cli.json",
        "postcss.config.*",
        ".storybook/**",
        "$NODE_ENV"
      ],
      "outputs": ["dist/**", ".next/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true,
      "inputs": ["src/**", "eslint.config.*", "eslint.lint-staged.mjs", "package.json", "tsconfig*.json"]
    },
    "test": {
      "cache": true,
      "inputs": ["src/**", "test/**", "tests/**", "**/*.test.*", "**/*.spec.*", "vitest.config.*", "package.json"],
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "cache": true,
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "swagger:gen": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["openapi/**"]
    },
    "openapi:gen": {
      "cache": false,
      "dependsOn": ["swagger:gen"]
    },
    "contracts:check": {
      "cache": false,
      "dependsOn": []
    }
  }
}
