{
  "name": "@ecom/ui-seller",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pages/*": {
      "types": "./src/pages/*/index.ts",
      "development": "./src/pages/*/index.ts",
      "import": "./src/pages/*/index.ts",
      "default": "./src/pages/*/index.ts"
    },
    "./layouts/*": {
      "types": "./src/layouts/*/index.ts",
      "development": "./src/layouts/*/index.ts",
      "import": "./src/layouts/*/index.ts",
      "default": "./src/layouts/*/index.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6008",
    "build": "tsup",
    "clean": "rm -rf dist",
    "build-storybook": "storybook build",
    "lint": "pnpm exec eslint --no-error-on-unmatched-pattern src/",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ecom/core-ui": "workspace:*",
    "@ecom/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.25.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@ecom/config": "workspace:*",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
