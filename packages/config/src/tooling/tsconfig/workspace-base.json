{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@ecom/api-client": ["./packages/api-client/src/index.ts"],
      "@ecom/api-client/*": ["./packages/api-client/src/*"],
      "@ecom/auth": ["./packages/auth/src/index.ts"],
      "@ecom/auth/*": ["./packages/auth/src/*"],
      "@ecom/config": ["./packages/config/src/index.ts"],
      "@ecom/config/*": ["./packages/config/src/*"],
      "@ecom/contracts": ["./packages/contracts/src/index.ts"],
      "@ecom/contracts/*": ["./packages/contracts/src/*"],
      "@ecom/core-ui": ["./packages/core-ui/src/index.ts"],
      "@ecom/core-ui/*": ["./packages/core-ui/src/*"],
      "@ecom/database": ["./packages/database/src/index.ts"],
      "@ecom/database/*": ["./packages/database/src/*"],
      "@ecom/email": ["./packages/email/src/index.ts"],
      "@ecom/email/*": ["./packages/email/src/*"],
      "@ecom/nestjs-core": ["./packages/nestjs-core/src/index.ts"],
      "@ecom/nestjs-core/*": ["./packages/nestjs-core/src/*"],
      "@ecom/redis": ["./packages/redis/src/index.ts"],
      "@ecom/redis/*": ["./packages/redis/src/*"],
      "@ecom/shared": ["./packages/shared/src/index.ts"],
      "@ecom/shared/*": ["./packages/shared/src/*"],
      "@ecom/testing": ["./packages/testing/src/index.ts"],
      "@ecom/testing/*": ["./packages/testing/src/*"],
      "@ecom/ui-admin": ["./packages/ui-admin/src/index.ts"],
      "@ecom/ui-admin/*": ["./packages/ui-admin/src/*"],
      "@ecom/ui-seller": ["./packages/ui-seller/src/index.ts"],
      "@ecom/ui-seller/*": ["./packages/ui-seller/src/*"],
      "@ecom/ui-storefront": ["./packages/ui-storefront/src/index.ts"],
      "@ecom/ui-storefront/*": ["./packages/ui-storefront/src/*"]
    }
  }
}
