{
  "name": "@ecom/contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./enums": {
      "types": "./src/enums/index.ts",
      "development": "./src/enums/index.ts",
      "import": "./src/enums/index.ts",
      "default": "./src/enums/index.ts"
    },
    "./enums/*": {
      "types": "./src/enums/*.ts",
      "development": "./src/enums/*.ts",
      "import": "./src/enums/*.ts",
      "default": "./src/enums/*.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "development": "./src/http/index.ts",
      "import": "./src/http/index.ts",
      "default": "./src/http/index.ts"
    },
    "./http/*": {
      "types": "./src/http/*.ts",
      "development": "./src/http/*.ts",
      "import": "./src/http/*.ts",
      "default": "./src/http/*.ts"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "development": "./src/common/index.ts",
      "import": "./src/common/index.ts",
      "default": "./src/common/index.ts"
    },
    "./admin/chat": {
      "types": "./src/admin/chat/index.ts",
      "development": "./src/admin/chat/index.ts",
      "import": "./src/admin/chat/index.ts",
      "default": "./src/admin/chat/index.ts"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "development": "./src/generated/index.ts",
      "import": "./src/generated/index.ts",
      "default": "./src/generated/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "openapi:gen": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ecom/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
