{
  "name": "@ecom/notification",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "pnpm exec eslint --no-error-on-unmatched-pattern src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ecom/database": "workspace:*",
    "@ecom/shared": "workspace:*",
    "@nestjs/bullmq": "*"
  },
  "devDependencies": {
    "@ecom/config": "workspace:*",
    "@types/node": "^25.7.0",
    "bullmq": "*",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "@nestjs/core": "*"
  }
}
