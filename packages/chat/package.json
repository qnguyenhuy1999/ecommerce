{
  "name": "@ecom/chat",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "pnpm exec eslint --no-error-on-unmatched-pattern src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ecom/auth": "workspace:*",
    "@ecom/database": "workspace:*",
    "@ecom/nestjs-core": "workspace:*",
    "@ecom/redis": "workspace:*",
    "@ecom/shared": "workspace:*"
  },
  "devDependencies": {
    "@ecom/config": "workspace:*",
    "@types/node": "^25.9.1",
    "ioredis": "^5.11.0",
    "socket.io": "^4.8.1",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "@nestjs/core": "*",
    "@nestjs/websockets": "*",
    "@nestjs/platform-socket.io": "*"
  }
}
