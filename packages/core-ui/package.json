{
  "name": "@ecom/core-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./atoms/*": {
      "types": "./src/atoms/*/*.tsx",
      "development": "./src/atoms/*/*.tsx",
      "import": "./src/atoms/*/*.tsx",
      "default": "./src/atoms/*/*.tsx"
    },
    "./molecules/*": {
      "types": "./src/molecules/*/*.tsx",
      "development": "./src/molecules/*/*.tsx",
      "import": "./src/molecules/*/*.tsx",
      "default": "./src/molecules/*/*.tsx"
    },
    "./organisms/*": {
      "types": "./src/organisms/*/*.tsx",
      "development": "./src/organisms/*/*.tsx",
      "import": "./src/organisms/*/*.tsx",
      "default": "./src/organisms/*/*.tsx"
    },
    "./layouts/*": {
      "types": "./src/layouts/*/*.tsx",
      "development": "./src/layouts/*/*.tsx",
      "import": "./src/layouts/*/*.tsx",
      "default": "./src/layouts/*/*.tsx"
    },
    "./pages/*": {
      "types": "./src/pages/*/index.ts",
      "development": "./src/pages/*/index.ts",
      "import": "./src/pages/*/index.ts",
      "default": "./src/pages/*/index.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "development": "./src/hooks/*.ts",
      "import": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/utils": {
      "types": "./src/lib/utils.ts",
      "development": "./src/lib/utils.ts",
      "import": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./vendors/react-hook-form": {
      "types": "./src/vendors/react-hook-form.ts",
      "development": "./src/vendors/react-hook-form.ts",
      "import": "./src/vendors/react-hook-form.ts",
      "default": "./src/vendors/react-hook-form.ts"
    },
    "./vendors/zod-resolver": {
      "types": "./src/vendors/zod-resolver.ts",
      "development": "./src/vendors/zod-resolver.ts",
      "import": "./src/vendors/zod-resolver.ts",
      "default": "./src/vendors/zod-resolver.ts"
    },
    "./vendors/zod": {
      "types": "./src/vendors/zod.ts",
      "development": "./src/vendors/zod.ts",
      "import": "./src/vendors/zod.ts",
      "default": "./src/vendors/zod.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "development": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./providers/ThemeProvider": {
      "types": "./src/providers/ThemeProvider.tsx",
      "development": "./src/providers/ThemeProvider.tsx",
      "import": "./src/providers/ThemeProvider.tsx",
      "default": "./src/providers/ThemeProvider.tsx"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build": "tsup",
    "clean": "rm -rf dist",
    "build-storybook": "storybook build",
    "lint": "pnpm exec eslint --no-error-on-unmatched-pattern src/",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ecom/config": "workspace:*",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/recharts": "^2.0.1",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "storybook": "^10.5.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@ecom/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.3",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  }
}
