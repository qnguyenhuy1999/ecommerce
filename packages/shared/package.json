{
  "name": "@ecom/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "development": "./src/constants/index.ts",
      "import": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "development": "./src/constants/*.ts",
      "import": "./src/constants/*.ts",
      "default": "./src/constants/*.ts"
    },
    "./pagination/core": {
      "types": "./src/pagination/core/index.ts",
      "development": "./src/pagination/core/index.ts",
      "import": "./src/pagination/core/index.ts",
      "default": "./src/pagination/core/index.ts"
    },
    "./pagination/core/*": {
      "types": "./src/pagination/core/*.ts",
      "development": "./src/pagination/core/*.ts",
      "import": "./src/pagination/core/*.ts",
      "default": "./src/pagination/core/*.ts"
    },
    "./pagination/nestjs": {
      "types": "./src/pagination/nestjs/index.ts",
      "development": "./src/pagination/nestjs/index.ts",
      "import": "./src/pagination/nestjs/index.ts",
      "default": "./src/pagination/nestjs/index.ts"
    },
    "./pagination/nestjs/*": {
      "types": "./src/pagination/nestjs/*.ts",
      "development": "./src/pagination/nestjs/*.ts",
      "import": "./src/pagination/nestjs/*.ts",
      "default": "./src/pagination/nestjs/*.ts"
    },
    "./pagination/prisma": {
      "types": "./src/pagination/prisma/index.ts",
      "development": "./src/pagination/prisma/index.ts",
      "import": "./src/pagination/prisma/index.ts",
      "default": "./src/pagination/prisma/index.ts"
    },
    "./pagination/prisma/*": {
      "types": "./src/pagination/prisma/*.ts",
      "development": "./src/pagination/prisma/*.ts",
      "import": "./src/pagination/prisma/*.ts",
      "default": "./src/pagination/prisma/*.ts"
    },
    "./pagination/react": {
      "types": "./src/pagination/react/index.ts",
      "development": "./src/pagination/react/index.ts",
      "import": "./src/pagination/react/index.ts",
      "default": "./src/pagination/react/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "development": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "development": "./src/utils/*.ts",
      "import": "./src/utils/*.ts",
      "default": "./src/utils/*.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "development": "./src/errors/index.ts",
      "import": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@nestjs/swagger": ">=7.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ecom/config": "workspace:*",
    "@nestjs/swagger": "^11.4.6",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "client-only": "^0.0.1",
    "react": "^19.2.8",
    "server-only": "^0.0.1",
    "vitest": "^4.1.10"
  }
}
